# MTB Love - Apache Configuration
# Konfiguration für mtblove.com

# Aktiviere mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # API Requests an backend/api/index.php weiterleiten
    RewriteRule ^api/(.*)$ backend/api/index.php [L,QSA]

    # Assets aus frontend/dist/assets/ ausliefern
    RewriteRule ^assets/(.*)$ frontend/dist/assets/$1 [L]

    # Logo von Root ausliefern
    RewriteRule ^logo\.(svg|jpg|png)$ logo.$1 [L]

    # Statische Assets direkt ausliefern
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Upload-Verzeichnis erlauben
    RewriteCond %{REQUEST_URI} ^/uploads/
    RewriteRule ^ - [L]

    # Redirect /wallpapers to standalone gallery
    RewriteRule ^wallpapers/?$ /wallpapers-standalone.html [R=301,L]

    # Alle anderen Requests an React Frontend weiterleiten
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ frontend/dist/index.html [L]
</IfModule>

# MIME Types für Assets
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
</IfModule>

# Sicherheitsheader
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Verhindere Zugriff auf sensible Dateien
<FilesMatch "^(config\.php|\.git|\.env|composer\.json|package\.json)">
    Require all denied
</FilesMatch>

# Verhindere Directory Listing
Options -Indexes

# PHP Einstellungen (optional, falls erlaubt)
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
