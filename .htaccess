# Minimale .htaccess für mtblove.com - Plesk Edition
# Verwende diese Version wenn die normale .htaccess Probleme macht

# Standard-Index
DirectoryIndex index.php

# Verhindere Zugriff auf sensible Dateien
<FilesMatch "^(config\.php|\.git)">
    Require all denied
</FilesMatch>

# Nur Rewrite wenn mod_rewrite verfügbar
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Memes/Uploads Verzeichnis umleiten
    RewriteRule ^memes/uploads/(.+)$ app/public/memes/uploads/$1 [L]

    # Existierende Dateien nicht umschreiben
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Clean URLs (optional - kann auskommentiert werden)
    RewriteRule ^login$ app/public/login.php [L]
    RewriteRule ^logout$ app/public/logout.php [L]
    RewriteRule ^admin-center$ app/public/dashboard/dashboard.php [L]
    RewriteRule ^dashboard/upload_handler\.php$ app/public/dashboard/upload_handler.php [L]
    RewriteRule ^dashboard/edit_handler\.php$ app/public/dashboard/edit_handler.php [L]
    RewriteRule ^dashboard/delete_handler\.php$ app/public/dashboard/delete_handler.php [L]
</IfModule>

# Sicherheitsheader
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
